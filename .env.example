# Set in Render's Environment settings; never commit real values.
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
DASHBOARD_PASSWORD=choose-a-long-private-dashboard-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
INITIAL_PROFILE_JSON={"display_name":"Your name","resume_facts":[],"evidence_for_outreach":""}
# Optional external scheduler token; health monitoring needs no token.
AUTOMATION_TOKEN=replace-with-a-random-value-at-least-32-characters
